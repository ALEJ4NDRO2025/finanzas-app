# Copia este archivo a .env solo para desarrollo local. Nunca subas .env al repo.
NODE_ENV=development
PORT=3000
# Obligatorio en producción, mínimo 32 caracteres. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
DB_PATH=./data/finanzas.db
# Orígenes extra permitidos, separados por coma (opcional)
ALLOWED_ORIGINS=
