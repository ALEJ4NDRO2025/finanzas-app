# Copia este archivo a .env solo para desarrollo local. Nunca subas .env al repo.
NODE_ENV=development
PORT=3000
# Opcional. Si lo dejas vacío, el servidor genera jwt.key junto a la base la primera vez
# (recomendado: el secreto nunca sale del servidor). Si lo pones, mínimo 32 caracteres.
JWT_SECRET=
DB_PATH=./data/finanzas.db
# Orígenes extra permitidos, separados por coma (opcional)
ALLOWED_ORIGINS=
